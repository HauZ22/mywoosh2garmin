# Kopiere diese Datei nach .env und trage deine Zugangsdaten ein.
# Alle Felder sind optional — die Konten lassen sich auch über die Web-App
# unter http://<host>:8080 konfigurieren.

# Garmin Connect (E-Mail + Passwort, nur erstmalig zum Login nötig — Token wird in /data gecacht)
GARMIN_EMAIL=
GARMIN_PASSWORD=

# MyWhoosh (E-Mail + Passwort)
MYWHOOSH_EMAIL=
MYWHOOSH_PASSWORD=

# Standard-Zeitfenster für den MyWhoosh-Sync (Tage)
SYNC_DAYS=10