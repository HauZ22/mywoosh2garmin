# Kopiere diese Datei nach .env und passe sie an.
# Alle Felder sind optional — die Konten lassen sich auch über die Web-App
# unter http://<host>:8080 konfigurieren.

# --- Welche Version läuft? ---
# latest | 1.2.3 (feste Version) | edge (Vorabversion vom main-Branch)
IMAGE_TAG=latest

# --- Garmin Connect (nur für den Erst-Login nötig, danach wird das Token in /data gecacht) ---
GARMIN_EMAIL=
GARMIN_PASSWORD=

# --- MyWhoosh ---
MYWHOOSH_EMAIL=
MYWHOOSH_PASSWORD=

# Standard-Zeitfenster für den MyWhoosh-Sync (Tage)
SYNC_DAYS=10

# --- Zugriffsschutz der Web-App (HTTP Basic Auth) ---
# Empfohlen, sobald der Port nicht nur lokal erreichbar ist. Leeres Passwort = kein Schutz.
AUTH_USER=admin
AUTH_PASSWORD=

# Host-Port der Web-App
HTTP_PORT=8080
TZ=Europe/Berlin
